# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# The pipeline will use template-based fallback if this is not set
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model for icebreaker generation (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Lemlist API Key (for future direct API integration)
# LEMLIST_API_KEY=your_lemlist_api_key_here
